# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# >>> AVISO COSTE <<<
# Service Bus Standard tier ~10 EUR/mes (no hay free tier). Apaga el
# Resource Group cuando termines: az group delete -n <RG> --yes --no-wait

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m04-s43

# Storage Account (3-24 chars). Lo necesita AzureWebJobsStorage.
STORAGE=stcursom04s43CAMBIA

# Function App
FUNC=func-curso-m04-s43-CAMBIA-INICIALES

# Service Bus namespace (6-50 chars). La cola lleva DLQ habilitada;
# el ProcesarDeadLetter triggerea sobre pedidos-procesar/$deadletterqueue.
SB=sb-curso-m04-s43-CAMBIA-INICIALES
SB_QUEUE_PEDIDOS=pedidos-procesar

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
