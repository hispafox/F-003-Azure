# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Cosmos serverless + Storage → coste ~0. Borra el RG al acabar.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m04-s4p

# Storage Account (3-24 chars). AzureWebJobsStorage + blob "facturas/" +
# queue "facturas-generadas".
STORAGE=stcursom04s4pCAMBIA

# Function App (unico globalmente)
FUNC=func-curso-m04-s4p-CAMBIA-INICIALES

# Cosmos DB (3-44 chars). Origen del Change Feed.
COSMOS=cosmos-curso-m04-s4p-CAMBIA-INICIALES
COSMOS_DB=tienda
COSMOS_PEDIDOS=pedidos

# Recursos del flujo
QUEUE=facturas-generadas
BLOB_CONTAINER=facturas

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
