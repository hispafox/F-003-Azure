# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Consumption puro: sin Service Bus ni Cosmos → coste ~0. Aun asi,
# borra el RG al acabar con ./04-cleanup.sh.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m04-s44

# Storage Account (3-24 chars). Lo necesita el runtime de Functions.
STORAGE=stcursom04s44CAMBIA

# Function App (unico globalmente)
FUNC=func-curso-m04-s44-CAMBIA-INICIALES

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
