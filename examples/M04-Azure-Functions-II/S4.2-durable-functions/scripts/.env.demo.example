# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Durable Functions usa el Storage Account del Function App para historial
# + colas internas. SIN Service Bus ni Cosmos: coste ~0 (Consumption +
# Storage trivial). Aun asi, borra el RG al acabar.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m04-s42

# Storage Account (3-24 chars). Durable persiste aqui historial y colas.
STORAGE=stcursom04s42CAMBIA

# Function App (unico globalmente)
FUNC=func-curso-m04-s42-CAMBIA-INICIALES

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
