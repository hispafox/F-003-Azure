# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# >>> AVISO COSTE <<<
# Service Bus Standard tier ~10 EUR/mes (no hay free tier). Apaga el
# Resource Group cuando termines: az group delete -n <RG> --yes --no-wait

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m04-s41

# Storage Account (3-24 chars). Lo necesita AzureWebJobsStorage + sirve
# como source de Event Grid (BlobCreated del container 'uploads').
STORAGE=stcursom04s41CAMBIA

# Function App
FUNC=func-curso-m04-s41-CAMBIA-INICIALES

# Service Bus namespace (6-50 chars, alfanumerico y guiones)
SB=sb-curso-m04-s41-CAMBIA-INICIALES
SB_QUEUE_PEDIDOS=pedidos-procesar
SB_QUEUE_FACTURAS=facturas-procesar
SB_QUEUE_IMPORTS=imports-procesar
SB_TOPIC_EVENTOS=pedidos-eventos
SB_SUB_NOTIFICACIONES=sub-notificaciones

# Container de Storage usado por Event Grid (BlobCreated)
CONTAINER_UPLOADS=uploads

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
