# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo está ignorado por git — no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope

# La práctica del M01 usa nombres FIJOS que se reutilizan en M02-S2.P (slots).
# Sigue las convenciones de la slide 4 de la práctica.
RG=rg-curso-azure-CAMBIA-INICIALES
PLAN=plan-curso-CAMBIA-INICIALES
APP=app-curso-CAMBIA-INICIALES

# Nombre que aparecerá como "asistente" en el JSON de respuesta
ASISTENTE=Pedro

# Recursos opcionales (slides 55-58: Application Insights workspace-based)
LAW=law-curso-CAMBIA-INICIALES
APPI=appi-curso-CAMBIA-INICIALES

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
