# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope

# Resource Group de la practica (slide 7).
# Cambia "CAMBIA-INICIALES" por algo unico tuyo.
RG=rg-cloudshell-CAMBIA-INICIALES

# Nombre del Storage Account (slide 8). Debe ser unico globalmente,
# 3-24 chars, solo letras minusculas y numeros (sin guiones ni mayusculas).
# Si ya existe, anade un sufijo numerico.
STORAGE=stcloudshellCAMBIA01
