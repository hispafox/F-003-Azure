# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Cosmos DB SERVERLESS → pago por RU consumida, ≈ 0 € sin uso (slide 7/21).
# Borra el RG al acabar con ./03-cleanup.sh.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m05-s53

# Cuenta Cosmos (nombre único global, minúsculas/numeros/guiones)
COSMOS_ACCOUNT=cosmos-curso-m05s53-CAMBIA
COSMOS_DB=tienda
COSMOS_CONTAINER=pedidos
