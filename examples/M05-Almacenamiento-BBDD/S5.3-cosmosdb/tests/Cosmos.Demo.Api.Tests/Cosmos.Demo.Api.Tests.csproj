         arranca → `dotnet test` siempre verde. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="Testcontainers.CosmosDb" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cosmos.Demo.Api\Cosmos.Demo.Api.csproj" />
  </ItemGroup>

</Project>
