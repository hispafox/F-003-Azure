# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Cosmos serverless + App Service F1 → coste < 1 € (slide 3).
# Borra el RG al acabar con ./03-cleanup.sh.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m05-s5p

# Cuenta Cosmos (nombre único global)
COSMOS_ACCOUNT=cosmos-curso-m05sp-CAMBIA

# App Service (nombre único global) — se le habilita Managed Identity
APP_NAME=app-curso-m05sp-CAMBIA
