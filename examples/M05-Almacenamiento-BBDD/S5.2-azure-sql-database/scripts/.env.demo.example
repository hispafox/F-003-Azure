# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Azure SQL serverless (auto-pausa a los 60 min) → coste ≈ 0 € parado.
# Borra el RG al acabar con ./03-cleanup.sh.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m05-s52

# Servidor lógico SQL (nombre único global, minúsculas/numeros)
SQL_SERVER=sql-curso-m05s52-CAMBIA
SQL_DB=db-ventas

# Admin SQL (en producción: Entra ID + Managed Identity, slide 6/20)
SQL_ADMIN=sqladmin
SQL_PASSWORD=Cambia_Esta_Clave_123!

# Tu IP pública para la regla de firewall (https://ifconfig.me)
MY_IP=0.0.0.0
