<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Provider de Azure SQL / SQL Server para EF Core (slides 6-8, 13). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <!-- Design-time: necesario para `dotnet ef migrations` (slide 8). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Auth con Entra ID / Managed Identity sin password (slides 6, 20). -->
    <PackageReference Include="Azure.Identity" Version="1.14.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sql.Demo.Api.Tests" />
  </ItemGroup>

</Project>
