# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# App Service F1 (gratis) + Storage StorageV2 → coste ≈ 0 €.
# Borra el RG al acabar con ./03-cleanup.sh.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m05-s54

# App Service (nombre único global) — se le habilita Managed Identity
APP_NAME=app-curso-m05s54-CAMBIA

# Storage Account (3-24, minúsculas/numeros, único global) — destino MI
STORAGE=stcursom05s54CAMBIA
