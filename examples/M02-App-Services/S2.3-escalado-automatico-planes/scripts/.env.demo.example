# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo está ignorado por git — no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m02-s23
PLAN=plan-curso-m02-s23

# IMPORTANTE: el nombre debe ser único globalmente
APP=app-curso-m02-s23-CAMBIA-INICIALES

# Path absoluto al ZIP que se va a desplegar (lo genera 02-deploy.sh
# si no existe llamando a `dotnet publish` antes)
ZIP_PATH=./out/app.zip
