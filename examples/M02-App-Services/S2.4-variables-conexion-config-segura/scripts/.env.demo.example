# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo está ignorado por git — no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m02-s24
PLAN=plan-curso-m02-s24

# IMPORTANTE: nombre único globalmente
APP=app-curso-m02-s24-CAMBIA-INICIALES

# Key Vault — único globalmente, 3-24 chars, alfanumérico + guiones (sin consecutivos)
KV=kv-curso-m02-s24-CAMBIA

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
