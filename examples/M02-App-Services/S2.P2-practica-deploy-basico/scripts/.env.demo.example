# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo está ignorado por git — no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m02-sp2
PLAN=plan-curso-m02-sp2

# Único globalmente. Sugerencia: añade timestamp con $(date +%s) si quieres
# evitar choques de nombres.
APP=webapp-curso-m02-sp2-CAMBIA-INICIALES

# Path al ZIP que se despliega (lo genera 02-deploy.sh)
ZIP_PATH=./out/app.zip
