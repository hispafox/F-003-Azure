# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m03-s35

# Storage Account (3-24 chars, letras minusculas y numeros)
STORAGE=stcursom03s35CAMBIA

# Function App (unico globalmente)
FUNC=func-curso-m03-s35-CAMBIA-INICIALES

# Cosmos DB account (3-44 chars, letras minusculas, numeros y guiones)
COSMOS=cosmos-curso-m03-s35-CAMBIA-INICIALES
COSMOS_DB=tienda
COSMOS_PEDIDOS=pedidos
COSMOS_RESUMENES=resumenes-clientes

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
