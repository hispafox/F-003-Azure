# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m03-s36

# Storage Account (3-24 chars, letras minusculas y numeros)
# Aloja AzureWebJobsStorage + la queue "pedidos-pendientes" + los blobs "exports/"
STORAGE=stcursom03s36CAMBIA

# Function App (unico globalmente)
FUNC=func-curso-m03-s36-CAMBIA-INICIALES

# Cosmos DB account (3-44 chars, letras minusculas, numeros y guiones)
COSMOS=cosmos-curso-m03-s36-CAMBIA-INICIALES
COSMOS_DB=tienda
COSMOS_PEDIDOS=pedidos

# Storage Queue donde CrearPedidoFunction encola mensajes (slide 6).
QUEUE=pedidos-pendientes
# Storage container donde ExportarPedidoFunction escribe los blobs (slide 10).
BLOB_CONTAINER=exports

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
