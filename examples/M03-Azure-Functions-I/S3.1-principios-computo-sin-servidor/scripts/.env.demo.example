# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope
RG=rg-curso-m03-s31

# Storage Account requerido por el runtime de Functions (slide 14).
# 3-24 chars, solo letras minusculas y numeros.
STORAGE=stcursom03s31CAMBIA

# Function App (unique global). 2-60 chars, letras/numeros/guiones.
FUNC=func-curso-m03-s31-CAMBIA-INICIALES

# Path al ZIP que se despliega
ZIP_PATH=./out/app.zip
