# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Scripts SOLO LECTURA (inventario de Service Bus). No crean ni borran
# nada → no hay cleanup.
#
# ⚠️  COSTE: un namespace Service Bus *Standard* (necesario para topics,
#     suscripciones y filtros SQL) cuesta ~10 €/mes FIJOS aunque no lo
#     uses. Bórralo desde el Portal cuando termines la práctica.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RG=rg-curso-messaging-CAMBIA
SB_NAMESPACE=sb-curso-CAMBIA
SB_TOPIC=pedidos-eventos
SB_QUEUE=pedidos-dedup
