# Copia este archivo a `.env.demo` y rellena con tus datos
# (.env.demo esta ignorado por git -- no se sube)
#
# Scripts SOLO LECTURA: inventarían una instancia de APIM existente.
# No crean ni borran nada → no hay cleanup.
#
# ⚠️  COSTE: APIM *Consumption* = 0 € base (1M llamadas/mes gratis).
#     Developer ~40 €/mes, Standard ~550 €/mes, Premium ~2200 €/mes.
#     Si creaste un tier no-Consumption, bórralo desde el Portal.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RG=rg-curso-apim-CAMBIA
APIM_NAME=apim-curso-CAMBIA
