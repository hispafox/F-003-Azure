# (.env.demo esta ignorado por git -- no se sube)
#
# Scripts SOLO LECTURA: inventarían un Azure DevOps project existente.
# No crean ni borran nada → no hay cleanup.
#
# 💡 Azure DevOps gratis para equipos < 5 personas; 6 €/usuario/mes a
#    partir de ahí. Sin coste si solo usas Repos/Boards.

ORG_URL=https://dev.azure.com/mi-organizacion
PROJECT=mi-proyecto
